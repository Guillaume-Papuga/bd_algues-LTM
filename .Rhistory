# Libraries :
library(ade4)
library(psych)
require(factoextra)
load("acariens.rda") #pensez bien à changer le setwd et à mettre le fichier acariens.rda dans le dossier en question
detach(acariens)
attach(acariens) # pour s'économiser un $
morpho
data<-acariens$morpho
data$esp<-acariens$esp #crée la colonne esp pour joindre les tableaux
data<-data[,c(ncol(data),1:27)] #réorganise les colonnes pour avoir esp en première colonne
windows()
pairs.panels(morpho,
method = "spearman", # correlation method
hist.col = "#00AFBB",
density = TRUE,  # show density plots
ellipses = FALSE # show correlation ellipses
)
acp<-dudi.pca(morpho, scale=T, center=T) #ACP avec ade4
# Calcul et mise en forme des pourcentages d'inertie
pc<-round(acp$eig/sum(acp$eig)*100,2)
acp<-dudi.pca(morpho, scale=T, center=T) #ACP avec ade4
# Barplot des valeurs propres :
windows()
barplot(acp$eig, ylim=c(0, max(acp$eig)+1), xlab = "Axes factoriels", ylab = "Valeurs propres", main = "Barplot des valeurs propres", col="red")
abline(h=1, col="black", lty=2, lwd=2) #ajout de la ligne y=1
# Calcul et mise en forme des pourcentages d'inertie
pc<-round(acp$eig/sum(acp$eig)*100,2)
# Création du barplot
xx <- barplot(pc, xaxt = 'n', xlab = '', width = 0.85, ylim = c(0, 1.2*max(pc)), ylab = "% d'inertie")
## Ajout des valeurs de % en dessus des barres
text(x = xx, y = pc, label = pc, pos = 3, cex = 0.8, col = "black")
## Ajout des labels sur l'axe des x (ie. numero des axes factoriels)
axis(1, at=xx, labels=c(1:length(pc)), tick=FALSE, las=1, line=-0.5, cex.axis=0.8)
# Cercle des corrélations avec C1 et C2 :
windows()
s.corcircle(acp$co, xax=1, yax=2)
s.corcircle(acp$co, xax=2, yax=3)
