require(vegan)
require(ade4)
data(dune)
data(dune.env)
# Calcul Bray Curtis (en version metrique pour etre utilise dans PCoA). Notes : la plupart des indices non-metriques utilises en ecologie peuvent le devenir par une transformation racine carree (cf CM). Toutefois il est important de verifier a quel point cette transformation peut distordre l'information initiale
# Dissimilarite de Bray Curtis
bcu=vegdist(dune,"bray")
# Distance de Bray Curtis
bc=sqrt(vegdist(dune,"bray"))
# Comparaison des 2 matrices afin d'evaluer si la transformation racine carree a engendre une distorsion des donnees pour rendre la matrice metrique
plot(bc,bcu,xlim=c(0,1), ylim=c(0,1))
abline(0,1)
# Verifier si propriete euclidienne respectee, car sinon la PCoA peut generer des valeurs propres negatives sur les derniers axes (probleme s'ils doivent etre retenus)
is.euclid(bc)
# PCoA
pcbc=dudi.pco(bc)
pourc
cumsum(pourc)
# Projections des individus
s.label(pcbc$li, sub="Bray curtis")
# Calcul des distances euclidiennes entre objets sur le 1er plan factoriel
de=dist(pcbc$li[,1:2])
cont=inertia.dudi(pcbc, row.inertia = TRUE)
cos2=abs(cont$row.rel)/10000
par(mfrow = c(1,2))
plot(pcbc$li[,1], cos2[,1])
plot(pcbc$li[,2], cos2[,2])
c2p12=rowSums(cos2[,c(1,2)])
s.value(pcbc$li[,1:2], c2p12, method="greylevel",csize=0.4)
# Variables explicatives,  nombre de modalites et echantillons par modalite
table(dune.env$Management)
table(dune.env$Use)
# Interaction des 2 facteurs
int=as.factor(paste(dune.env$Management, dune.env$Use, sep="_"))
table(int)  # peu d'observations par modalite -> peu (pas) adapté pour tester cet effet. Code tout de meme ci-dessous dans le cas où serait pertinent
par(mfrow = c(1,3))
s.class(pcbc$li, dune.env$Management, col=c(1:4))
s.class(pcbc$li, dune.env$Use, col=c(1:3))
s.class(pcbc$li, int, col=c(1:11))
deu=dist(pcbc$li[,1:2])
require(vegan)
# Le test permutationnel d'homogeneite des dispersions est base sur les hypotheses suivantes :
# H0 : la dispersion intra-groupe est identique entre les groupes du facteur
# H1 : au moins une dispersion intra-groupe d un groupe est differente d'au moins une autre
bd <- betadisper(deu, dune.env$Management)
permutest(bd, permutations = 9999)
plot(bd)
boxplot(bd)
bd1 <- betadisper(deu, dune.env$Use)
permutest(bd1, permutations = 9999)
plot(bd1)
boxplot(bd1)
bd2 <- betadisper(deu, int)
permutest(bd2, permutations = 9999)
plot(bd2)
boxplot(bd2)
# PERMANOVA
adonis2(deu ~ dune.env$Management, data=dune.env, permutations=9999)
adonis2(deu ~ dune.env$Use, data=dune.env, permutations=9999)
adonis2(deu ~ dune.env$Use*dune.env$Management, permutations=9999, by="margin")
# Post-Hoc si rejet de H0 dans PERMANOVA
library(pairwiseAdonis)
pairwise.adonis2(deu ~ Management, data = dune.env, permutations = 9999,p.adjust.m = "BH")
s.class(pcbc$li, dune.env$Management, col=c(1:4))
# Projection a posteriori de la contribution des variables (correlations des especes aux axes)
require(ape)
pcobc=pcoa(bc)
biplot(pcobc, dune)
require(labdsv)
# nMDS sur matrice initiale de dissimilarite de Bray-Curtis (semi-metrique) calcule dans l'application ci-dessus
bn2=bestnmds(bcu,k=2)
bn4=bestnmds(bcu,k=4)
